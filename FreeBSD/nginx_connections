#!/bin/sh
#
# minimunin/munin plugin: nginx connection states (from stub_status).
# Needs the 127.0.0.1:8080/nginx_status location from nginx.conf.
#
#%# family=auto
#%# capabilities=autoconf

URL="${NGINX_STATUS_URL:-http://127.0.0.1:8080/nginx_status}"

status() {
    /usr/bin/fetch -q -T 5 -o - "$URL" 2>/dev/null
}

if [ "$1" = "autoconf" ]; then
    if status | grep -q '^Active connections'; then
        echo yes
        exit 0
    fi
    echo "no (cannot read ${URL})"
    exit 1
fi

if [ "$1" = "config" ]; then
    echo 'graph_title nginx connections'
    echo 'graph_args --base 1000 -l 0'
    echo 'graph_vlabel connections'
    echo 'graph_category nginx'
    echo 'graph_info Current nginx connections by state, from stub_status.'
    for f in active reading writing waiting; do
        echo "${f}.label ${f}"
        echo "${f}.type GAUGE"
        echo "${f}.min 0"
    done
    exit 0
fi

status | awk '
    /^Active connections:/ { print "active.value "  $3 }
    /^Reading:/            { print "reading.value " $2
                             print "writing.value " $4
                             print "waiting.value " $6 }'
